# --- DATABASE CONFIGURATION (Neon.tech) --- #

# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"


# --- AI & LLM API KEYS --- #

# [REQUIRED] Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="<your_gemini_api_key_here>"

# [OPTIONAL] Get from: https://platform.iteracompute.com/
# Leave empty if you don't want to test the fallback chain.
ITERACOMPUTE_API_KEY=""

# [OPTIONAL] Get from: https://openrouter.ai/keys
# Leave empty if you don't want to test the fallback chain.
OPENROUTER_API_KEY="

# --- AIRFLOW CONFIGURATION (Docker Internal) --- #

# Credentials for the internal Airflow PostgreSQL database
DB_AIRFLOW_USER="airflow"
DB_AIRFLOW_PASSWORD="airflow"
DB_AIRFLOW_DB="airflow"

# Secret key for Airflow Webserver (Generate with: openssl rand -hex 32)
AIRFLOW_SECRET_KEY="<your_random_secret_key_here>"

# UID for Docker permissions (Run `id -u` in terminal to check yours)
AIRFLOW_UID=1000s
