# --- DATABASE CONFIGURATION ---
# DEFAULT: Gunakan Postgres lokal di Docker (langsung jalan tanpa setup)
DATABASE_URL="postgresql://postgres:postgres@postgres-neon:5432/karhutlarag?sslmode=disable"

# OPSIONAL: Jika ingin pakai Neon.tech, komentari baris di atas dan gunakan format ini:
# DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# --- AI & LLM API KEYS ---
GEMINI_API_KEY="<your_gemini_api_key_here>"
ITERACOMPUTE_API_KEY=""
OPENROUTER_API_KEY=""

# --- AIRFLOW CONFIGURATION (Docker Internal) ---
DB_AIRFLOW_USER="airflow"
DB_AIRFLOW_PASSWORD="airflow"
DB_AIRFLOW_DB="airflow"
AIRFLOW_SECRET_KEY="supersecretkey"
AIRFLOW_UID=1000
